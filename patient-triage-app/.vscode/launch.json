{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Express API",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/server.js",
      "cwd": "${workspaceFolder}/server",
      "envFile": "${workspaceFolder}/server/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Open Patient Intake",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5000",
      "webRoot": "${workspaceFolder}/client"
    },
    {
      "name": "Open Admin Dashboard",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5000/dashboard.html",
      "webRoot": "${workspaceFolder}/client"
    }
  ],
  "compounds": [
    {
      "name": "Debug API + Patient Intake",
      "configurations": ["Debug Express API", "Open Patient Intake"],
      "stopAll": true
    },
    {
      "name": "Debug API + Admin Dashboard",
      "configurations": ["Debug Express API", "Open Admin Dashboard"],
      "stopAll": true
    }
  ]
}
